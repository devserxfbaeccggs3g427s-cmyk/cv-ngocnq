RESEND_API_KEY=

# Sender address configured in Resend. For production, use a verified domain.
CONTACT_EMAIL_FROM="CV Website <onboarding@resend.dev>"

# Recipient address. Defaults to profile.email if omitted.
CONTACT_EMAIL_TO=quangngoc201197@gmail.com

# Optional GitHub backup defaults for /skill-roadmap.
# Keep the token server-side only; the app does not expose it to the browser.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO_URL=
GITHUB_BACKUP_BRANCH=cv-dev
GITHUB_BACKUP_PATH=src/data/skill-roadmap-progress.json
GITHUB_BACKUP_COMMIT_MESSAGE="Backup skill roadmap progress"

# Token-based AI authentication.
# Users enter their own AI provider token (API key) directly in the UI;
# the server forwards it to the provider as Authorization: Bearer <token>.
# AI_*_BASE_URL and AI_*_MODEL env vars below are used as defaults / fallbacks
# (e.g. when the user hasn't selected a model yet or for auto-generated features
# like AI context title generation and auto task-note generation that run
# without user interaction).

# Optional defaults for AI flashcard generation (used if the user has not
# picked their own base URL/model).
AI_FLASHCARD_BASE_URL=https://openrouter.ai/api/v1
AI_FLASHCARD_MODEL=

# Optional defaults for AI quiz generation.
AI_QUIZZ_BASE_URL=https://openrouter.ai/api/v1
AI_QUIZZ_MODEL=

# Optional defaults for Kilo AI / OpenAI-compatible comment "Hỏi AI".
AI_COMMENT_KILO_BASE_URL=https://openrouter.ai/api/v1
AI_COMMENT_KILO_MODEL=
AI_CONTEXT_TITLE_MODEL=
AI_IMAGE_ANALYSIS_MODEL=

# Optional server-side AI config for automatically generating parent task notes.
# This feature is opt-in. Without AI_TASK_NOTE_API_KEY below, the auto mode
# is disabled because it runs without user interaction.
# Note rewrite requests still work via the token the user enters in the UI.
AI_TASK_NOTE_ENABLED=false
AI_TASK_NOTE_BASE_URL=https://openrouter.ai/api/v1
AI_TASK_NOTE_MODEL=
